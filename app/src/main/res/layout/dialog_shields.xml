<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_shields_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: logo + domain + close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnShieldsClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_nav_button"
                android:src="@drawable/ic_close"
                android:padding="8dp"
                android:contentDescription="Close"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/btnShieldsClose"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/shieldsLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/brahman_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Brahman Shield"/>

                <TextView
                    android:id="@+id/shieldsDomain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- Big shield toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchShields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.4"
                android:scaleY="1.4"
                android:checked="true"/>

        </LinearLayout>

        <TextView
            android:id="@+id/shieldsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Brahman Shields  UP"
            android:textColor="@color/waterCyan"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4000B4D8"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Blocked count row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/shieldsBlockedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ads &amp; other\ncreepy things blocked"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If this site appears broken, try turning Shields off."
            android:textColor="#8090E0EF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4000B4D8"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"/>

        <!-- Advanced Controls header (tap to expand) -->
        <LinearLayout
            android:id="@+id/advancedHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_nav_button"
            android:padding="4dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Advanced controls"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="6dp"/>

            <ImageButton
                android:id="@+id/btnAdvancedArrow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_forward"
                android:rotation="90"
                android:padding="8dp"
                android:contentDescription="Expand"/>

        </LinearLayout>

        <!-- Advanced section (hidden by default) -->
        <LinearLayout
            android:id="@+id/advancedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp">

            <!-- Domain bold label -->
            <TextView
                android:id="@+id/advancedDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="4dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#4000B4D8"/>

            <!-- Upgrade to HTTPS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Upgrade connections to HTTPS"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHttps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#4000B4D8"/>

            <!-- Block Scripts -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Block Scripts"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBlockScripts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="false"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#4000B4D8"/>

            <!-- Forget me on close -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forget me when I close this site"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clears cookies &amp; storage on close"
                        android:textColor="@color/textHint"
                        android:textSize="10sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchForgetOnClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="false"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#4000B4D8"/>

            <!-- Block trackers & ads (info row) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Block trackers &amp; ads"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvTrackersLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Standard"
                    android:textColor="@color/waterCyan"
                    android:textSize="12sp"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#4000B4D8"/>

            <!-- Block Cookies -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block Cookies"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="May break some sites"
                        android:textColor="@color/textHint"
                        android:textSize="10sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBlockCookies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="false"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#4000B4D8"/>

            <!-- Block Fingerprinting -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Block fingerprinting"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBlockFingerprinting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true"/>
            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
