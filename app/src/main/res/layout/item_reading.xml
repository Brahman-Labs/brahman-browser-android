<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/bg_nav_button"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/readingIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_reader"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:padding="4dp"
        android:contentDescription="Reading"/>

    <ImageButton
        android:id="@+id/btnDeleteReading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_nav_button"
        android:src="@drawable/ic_delete"
        android:padding="8dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:contentDescription="Delete"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/readingIcon"
        android:layout_toStartOf="@id/btnDeleteReading"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/readingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/readingUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textHint"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="middle"/>

    </LinearLayout>

</RelativeLayout>
