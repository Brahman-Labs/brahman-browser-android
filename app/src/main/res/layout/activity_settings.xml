<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_water_gradient">

    <RelativeLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_top_bar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_nav_button"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Settings"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/settingsTopBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- SEARCH ENGINE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEARCH"
                android:textColor="@color/waterCyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/rowSearchEngine"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_language"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Search Engine"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvSearchEngine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/waterCyan"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Homepage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home"
                    android:layout_marginEnd="12dp"/>

                <EditText
                    android:id="@+id/etHomepage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Homepage URL"
                    android:textColorHint="@color/textHint"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"/>

            </LinearLayout>

            <!-- APPEARANCE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APPEARANCE"
                android:textColor="@color/waterCyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingBottom="4dp"/>

            <!-- Text size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_text_size"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text Size"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnTextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="S"
                    android:textSize="12sp"
                    android:background="@android:color/transparent"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnTextMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="M"
                    android:textSize="12sp"
                    android:background="@android:color/transparent"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnTextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="L"
                    android:textSize="12sp"
                    android:background="@android:color/transparent"/>

            </LinearLayout>

            <!-- Night Mode -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_night_mode"
                    android:layout_centerVertical="true"
                    android:id="@+id/nightIcon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/nightIcon"
                    android:layout_marginStart="12dp"
                    android:text="Night Mode"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNightMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>

            <!-- PRIVACY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRIVACY"
                android:textColor="@color/waterCyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingBottom="4dp"/>

            <!-- JavaScript -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/jsIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_javascript"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/jsIcon"
                    android:layout_marginStart="12dp"
                    android:text="JavaScript"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchJavascript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>

            <!-- Block Notifications -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/notifIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_info"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/notifIcon"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block Notification Popups"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-deny permission requests"
                        android:textColor="@color/textHint"
                        android:textSize="11sp"/>

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBlockNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>

            <!-- Block Autoplay -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/autoplayIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/autoplayIcon"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block Autoplay"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Require tap to play media"
                        android:textColor="@color/textHint"
                        android:textSize="11sp"/>

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBlockAutoplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>

            <!-- DATA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA"
                android:textColor="@color/waterCyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:id="@+id/rowClearHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear History"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowClearCache"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Cache &amp; Cookies"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowClearBookmarks"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bookmark"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Bookmarks"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- ABOUT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ABOUT"
                android:textColor="@color/waterCyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nav_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_info"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Brahman Browser"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0 — by Brahman Labs"
                        android:textColor="@color/textHint"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
