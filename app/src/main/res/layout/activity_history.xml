<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_water_gradient">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/historyTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_top_bar">

        <ImageButton
            android:id="@+id/btnHistoryBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nav_button"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="History"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp"/>

        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nav_button"
            android:src="@drawable/ic_clear_all"
            android:padding="10dp"
            android:contentDescription="Clear All"/>

    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/historyTopBar"
        android:padding="12dp">

        <EditText
            android:id="@+id/historySearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search history..."
            android:textColorHint="#80CAF0F8"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_address_bar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"/>

    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/emptyHistoryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No history yet"
        android:textColor="#80CAF0F8"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchLayout"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</RelativeLayout>
